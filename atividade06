//Escreva um programa que verifique se um número fornecido pelo usuário é positivo, negativo ou zero.

var numero = -5

if (numero == 0) {
    console.log("o numero é zero")
} else {
    if (numero > 0) {
        console.log("o numero é positivo")

    } else {
        console.log("o numero é negativo")

    }
}



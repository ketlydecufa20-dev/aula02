//Faça um programa que leia um número e verifique se ele está entre 1 e 100.
var numero=-4

if (numero > 0) {
    if (numero <= 100) {
        console.log("o numero está entre 1 e 100")
    }

    else {
        console.log("o numero não está entre 1 e 100")
    }

}

else {
    console.log("o numero não está entre 1 e 100")
}